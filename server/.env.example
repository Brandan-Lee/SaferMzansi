# Server settings
PORT=8080

# Supabase project credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# Signing key used to create login tokens
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Nearby support service lookup
GEOAPIFY_API_KEY=replace-with-your-geoapify-key

# SMTP email delivery
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=replace-with-your-smtp-password
FROM_NAME=SaferMzansi
FROM_EMAIL=alert@example.com
